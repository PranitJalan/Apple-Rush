[sub_resource type="GDScript" id="GDScript_afmmk"]
script/source = "extends Control

@onready var control: Control = $Control
@onready var margin_container: MarginContainer = $MarginContainer



func _ready() -> void:
	margin_container.scale = Vector2.ZERO
	control.scale = Vector2.ZERO
	await get_tree().process_frame
	margin_container.pivot_offset = margin_container.size/2
	control.pivot_offset = get_viewport_rect().size/2
	var tween = create_tween()
	tween.tween_property(margin_container, \"scale\", Vector2.ONE, 0.35)



	


func _on_button_pressed() -> void:
	var tween = create_tween()
	tween.tween_property(control, \"scale\", Vector2.ZERO, 0.35)
	tween.tween_property(margin_container, \"scale\", Vector2.ONE, 0.35)
	


func _on_button_2_pressed() -> void:
	var tween = create_tween()
	tween.tween_property(margin_container, \"scale\", Vector2.ZERO, 0.35)
	tween.tween_property(control, \"scale\", Vector2.ONE, 0.35)


func _on_button_pressed8() -> void:
	var tween = create_tween()
	tween.tween_property(margin_container, \"scale\", Vector2.ZERO, 0.35)
	await tween.finished
	get_tree().change_scene_to_file(\"res://scenes/Level.tscn\")
"

