[sub_resource type="GDScript" id="GDScript_jp6sd"]
script/source = "extends Area2D

@onready var animated_sprite_2d: AnimatedSprite2D = $AnimatedSprite2D

var locked := true
var offset := 8

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	if locked:
		if position != EVENT.spawn_position:
			if animated_sprite_2d.animation == \"out\":
				animated_sprite_2d.offset.x += offset
			animated_sprite_2d.play(\"default\")

func _ready() -> void:
	animated_sprite_2d.animation_finished.connect(on_finish)
	animated_sprite_2d.play(\"out\")

func _on_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"Player\") and position != EVENT.spawn_position:
		EVENT.spawn_position = position
		locked = false
		animated_sprite_2d.play_backwards(\"in\")

func on_finish():
	animated_sprite_2d.offset.x -= 8
	animated_sprite_2d.play(\"out\")
	locked = true
"

